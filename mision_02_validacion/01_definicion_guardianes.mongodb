use("bestiario");
db.guardianes.drop();
db.createCollection("guardianes", {
    validator: {
        $jsonSchema: {
            bsonType: "object",
            required: ["nombre", "rango", "password_acceso", "inventario"],
            properties: {
                name: {
                    bsonType: "string",
                },
                rango: {
                    bsonType: "string",
                    enum: ["Aprendiz", "Maestro", "Gran Maestro"],
                },
                password_acceso: {
                    bsonType: "string",
                    pattern: "^(?=.*[A-Z])(?=.*\\d).{8,}$", // Regex: Mínimo 8 caracteres, al menos una mayúscula y al menos un número.
                },
                nivel: {
                    bsonType: "number",
                    minimum: 1,
                    maximum: 99,
                },
                inventario: {
                    bsonType: "array",
                    items: {
                        bsonType: "object",
                        required: ["nombre_item", "cantidad"],
                        properties: {
                            nombre_item: {
                                bsonType: "string"
                            },
                            cantidad: {
                                bsonType: "number",
                                minimum: 1
                            }
                        }
                    }
                }
            }
        }
    }
}

)
